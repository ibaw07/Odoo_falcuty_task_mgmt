<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_faculty_lecturer_search" model="ir.ui.view">
        <field name="name">faculty.lecturer.search</field>
        <field name="model">faculty.lecturer</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Giảng viên">
                <field name="name" string="Họ và tên"/>
                <field name="lecturer_code" string="Mã giảng viên"/>
                <field name="rank_id" string="Bậc lương"/>
                <field name="position_title" string="Chức vụ"/>

                <filter string="Sắp đến hạn nâng bậc (<= 60 ngày)" name="filter_promotion_soon" domain="[('is_promotion_soon', '=', True)]"/>
                <filter string="Giáo sư / Phó Giáo sư" name="filter_professors" domain="[('academic_title', 'in', ['prof', 'assoc_prof'])]"/>
                <filter string="Tiến sĩ / TSKH" name="filter_doctors" domain="[('academic_degree', 'in', ['doctor', 'doctor_science'])]"/>

                <group expand="0" string="Gom nhóm theo">
                    <filter string="Chức vụ / Vị trí" name="group_position" context="{'group_by': 'position_title'}"/>
                    <filter string="Bậc lương" name="group_rank" context="{'group_by': 'rank_id'}"/>
                    <filter string="Học vị" name="group_degree" context="{'group_by': 'academic_degree'}"/>
                    <filter string="Học hàm" name="group_title" context="{'group_by': 'academic_title'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_faculty_lecturer_list" model="ir.ui.view">
        <field name="name">faculty.lecturer.list</field>
        <field name="model">faculty.lecturer</field>
        <field name="arch" type="xml">
            <list string="Danh sách Giảng viên" decoration-warning="is_promotion_soon">
                <field name="lecturer_code"/>
                <field name="name"/>
                <field name="academic_title"/>
                <field name="academic_degree"/>
                <field name="position_title"/>
                <field name="rank_id"/>
                <field name="days_to_promotion" string="Ngày đến hạn nâng bậc"/>
                <field name="teaching_actual_lecture" string="Giờ đứng lớp"/>
                <field name="teaching_actual_total" string="Tổng giờ GD"/>
                <field name="research_actual_total" string="Giờ NCKH"/>
                <field name="other_actual_total" string="Giờ HĐ khác"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_faculty_lecturer_form" model="ir.ui.view">
        <field name="name">faculty.lecturer.form</field>
        <field name="model">faculty.lecturer</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ Giảng viên">
                <header>
                    <button name="action_back_to_list" string="Quay lại danh sách" type="object" class="btn-secondary" icon="fa-arrow-left"/>
                    <button name="action_print_llkh" string="In Lý lịch Khoa học" type="object" class="btn-primary" icon="fa-print"/>
                    <button name="action_check_promotion_reminders" string="Quét nhắc nâng bậc" type="object" class="btn-info" icon="fa-bell-o" groups="faculty_work_mgmt.group_faculty_dean"/>
                </header>
                <sheet>
                    <!-- Cảnh báo nâng bậc lương nếu <= 60 ngày -->
                    <div class="alert alert-warning mb-3 d-flex align-items-center" role="alert" invisible="not is_promotion_soon">
                        <i class="fa fa-exclamation-triangle fa-2x me-3"/>
                        <div>
                            <strong>Cảnh báo nâng bậc lương:</strong> Giảng viên sắp đến hạn nâng bậc tiếp theo vào ngày
                            <strong><field name="next_rank_date" readonly="1" class="oe_inline"/></strong>
                            (còn <strong><field name="days_to_promotion" readonly="1" class="oe_inline"/></strong> ngày).
                        </div>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <span class="text-muted fw-bold">HỌ VÀ TÊN GIẢNG VIÊN</span>
                        <h1>
                            <field name="name" placeholder="VD: TS. Nguyễn Văn A"/>
                        </h1>
                        <h3>
                            <field name="rank_position_display" readonly="1" class="text-primary"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Thông tin Chức danh &amp; Bậc lương">
                            <field name="lecturer_code"/>
                            <field name="position_title"/>
                            <field name="academic_title"/>
                            <field name="title_appointment_year" invisible="academic_title == 'none'"/>
                            <field name="academic_degree"/>
                            <field name="degree_recognition_year"/>
                        </group>
                        <group string="Tiến độ Nâng bậc lương">
                            <field name="rank_id"/>
                            <field name="rank_date"/>
                            <field name="next_rank_date" readonly="1"/>
                            <field name="days_to_promotion" readonly="1"/>
                            <field name="is_promotion_soon" invisible="1"/>
                            <field name="active_academic_year_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <!-- Khung 5 cờ phân quyền trực quan -->
                    <div class="card mb-3 border-info">
                        <div class="card-header bg-light py-2">
                            <strong><i class="fa fa-shield me-2"/>Ủy quyền Tác vụ &amp; Phân quyền Nhanh (5 Cờ Phân quyền):</strong>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4">
                                    <field name="can_edit_subjects" widget="boolean_toggle"/>
                                    <span class="ms-1">Sửa CTĐT &amp; Môn học</span>
                                </div>
                                <div class="col-md-4">
                                    <field name="can_edit_classes" widget="boolean_toggle"/>
                                    <span class="ms-1">Mở lớp &amp; Chia học phần</span>
                                </div>
                                <div class="col-md-4">
                                    <field name="can_edit_exams" widget="boolean_toggle"/>
                                    <span class="ms-1">Nhập lịch &amp; Khảo thí</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4">
                                    <field name="can_edit_faculty_tasks" widget="boolean_toggle"/>
                                    <span class="ms-1">Phân công nhiệm vụ Khoa</span>
                                </div>
                                <div class="col-md-4">
                                    <field name="can_manage_hr" widget="boolean_toggle"/>
                                    <span class="ms-1">Quản lý Nhân sự &amp; Bậc lương</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ======================================================= -->
                    <!-- 3 Ô TIÊU CHÍ TINH GỌN (1. GIẢNG DẠY - 2. NCKH - 3. HĐ KHÁC) -->
                    <!-- ======================================================= -->
                    <div class="row mt-4">
                        <!-- Ô TIÊU CHÍ 1: GIẢNG DẠY -->
                        <div class="col-12 mb-4">
                            <div class="card shadow-sm border-primary">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                                    <h5 class="mb-0"><i class="fa fa-graduation-cap me-2"/>1. TIÊU CHÍ GIẢNG DẠY</h5>
                                    <div>
                                        <span class="badge bg-light text-primary me-2">Định mức sau giảm: <field name="teaching_norm_reduced" readonly="1" class="oe_inline"/> tiết</span>
                                        <span class="badge bg-light text-primary me-2">Giờ giảng ĐM (50%): <field name="teaching_norm_lecture_50" readonly="1" class="oe_inline"/> tiết</span>
                                        <span class="badge bg-warning text-dark me-2">Giờ đứng lớp TT: <field name="teaching_actual_lecture" readonly="1" class="oe_inline"/> tiết</span>
                                        <span class="badge bg-success me-2">Tổng giờ thực tế: <field name="teaching_actual_total" readonly="1" class="oe_inline"/> giờ</span>
                                        <span class="badge bg-secondary">Thừa/Thiếu: <field name="teaching_balance" readonly="1" class="oe_inline"/> giờ</span>
                                    </div>
                                </div>
                                <div class="card-body p-2">
                                    <field name="teaching_ledger_ids" readonly="1">
                                        <list string="Chi tiết Nhiệm vụ Giảng dạy đã quy đổi" limit="10">
                                            <field name="date" string="Ngày"/>
                                            <field name="activity_type" string="Loại nhiệm vụ"/>
                                            <field name="name" string="Chi tiết hoạt động"/>
                                            <field name="raw_hours" string="Số tiết/buổi gốc"/>
                                            <field name="coefficient" string="Hệ số"/>
                                            <field name="standard_hours" string="Giờ chuẩn"/>
                                            <field name="is_locked" widget="boolean"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>

                        <!-- Ô TIÊU CHÍ 2: NCKH -->
                        <div class="col-12 mb-4">
                            <div class="card shadow-sm border-success">
                                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
                                    <h5 class="mb-0"><i class="fa fa-flask me-2"/>2. TIÊU CHÍ NGHIÊN CỨU KHOA HỌC</h5>
                                    <div>
                                        <span class="badge bg-light text-success me-2">Định mức sau giảm: <field name="research_norm_reduced" readonly="1" class="oe_inline"/> giờ</span>
                                        <span class="badge bg-light text-dark me-2">Tổng giờ thực tế: <field name="research_actual_total" readonly="1" class="oe_inline"/> giờ</span>
                                        <span class="badge bg-secondary">Thừa/Thiếu: <field name="research_balance" readonly="1" class="oe_inline"/> giờ</span>
                                    </div>
                                </div>
                                <div class="card-body p-2">
                                    <field name="research_ledger_ids" readonly="1">
                                        <list string="Chi tiết Nhiệm vụ NCKH đã quy đổi" limit="10">
                                            <field name="date" string="Ngày"/>
                                            <field name="activity_type" string="Loại đề tài/bài báo"/>
                                            <field name="name" string="Chi tiết hoạt động"/>
                                            <field name="standard_hours" string="Giờ chuẩn"/>
                                            <field name="is_locked" widget="boolean"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>

                        <!-- Ô TIÊU CHÍ 3: HOẠT ĐỘNG KHÁC -->
                        <div class="col-12 mb-4">
                            <div class="card shadow-sm border-warning">
                                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-2">
                                    <h5 class="mb-0"><i class="fa fa-users me-2"/>3. TIÊU CHÍ HOẠT ĐỘNG KHÁC</h5>
                                    <div>
                                        <span class="badge bg-dark text-white me-2">Định mức sau giảm: <field name="other_norm_reduced" readonly="1" class="oe_inline"/> giờ</span>
                                        <span class="badge bg-light text-dark me-2">Tổng giờ thực tế: <field name="other_actual_total" readonly="1" class="oe_inline"/> giờ</span>
                                        <span class="badge bg-secondary">Thừa/Thiếu: <field name="other_balance" readonly="1" class="oe_inline"/> giờ</span>
                                    </div>
                                </div>
                                <div class="card-body p-2">
                                    <field name="other_ledger_ids" readonly="1">
                                        <list string="Chi tiết Hoạt động khác đã quy đổi" limit="10">
                                            <field name="date" string="Ngày"/>
                                            <field name="activity_type" string="Loại hoạt động"/>
                                            <field name="name" string="Chi tiết công việc"/>
                                            <field name="standard_hours" string="Giờ chuẩn"/>
                                            <field name="is_locked" widget="boolean"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ======================================================= -->
                    <!-- NOTEBOOK: CÁC TAB CHI TIẾT                               -->
                    <!-- ======================================================= -->
                    <notebook>
                        <!-- TAB 1: QUY HOẠCH & PHÁT TRIỂN CÁN BỘ -->
                        <page string="Quy hoạch &amp; Phát triển cán bộ" name="cadre_planning">
                            <group>
                                <group string="Quy hoạch chức danh lãnh đạo &amp; quản lý">
                                    <field name="cadre_planning_title"/>
                                    <field name="cadre_planning_period"/>
                                </group>
                                <group string="Kế hoạch đào tạo &amp; bồi dưỡng">
                                    <field name="training_development_plan" placeholder="Kế hoạch cử đi học cao cấp lý luận chính trị, nghiên cứu sinh, bồi dưỡng tiêu chuẩn chức danh nghề nghiệp..."/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 2: LÝ LỊCH KHOA HỌC 15 MỤC CHUẨN -->
                        <page string="Lý lịch Khoa học (15 Mục chuẩn)" name="scientific_cv">
                            <div class="alert alert-info py-2" role="alert">
                                <strong>Lưu ý:</strong> Bảng lý lịch khoa học phục vụ báo cáo hội đồng, phong chức danh và xét duyệt đề tài theo tiêu chuẩn 15 mục của Bộ GD&amp;ĐT / Bộ KH&amp;CN.
                            </div>

                            <!-- Mục 1 - 3: Thông tin cá nhân & Kỹ năng -->
                            <group string="1. Thông tin Cá nhân &amp; Ngoại ngữ - Tin học">
                                <group>
                                    <field name="gender"/>
                                    <field name="birth_date"/>
                                    <field name="place_of_birth"/>
                                    <field name="hometown"/>
                                </group>
                                <group>
                                    <field name="id_card_number"/>
                                    <field name="id_card_issue_date"/>
                                    <field name="id_card_place"/>
                                    <field name="office_address"/>
                                    <field name="foreign_languages"/>
                                    <field name="it_skills"/>
                                </group>
                            </group>

                            <!-- Mục 4, 5, 9, 10, 13: Bảng quá trình & Thành tích -->
                            <group string="4, 5, 9, 10, 13. Quá trình Đào tạo, Công tác, Đề tài KH&amp;CN, SHTT &amp; Giải thưởng">
                                <field name="resume_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="type" string="Phân loại mục"/>
                                        <field name="period" string="Thời gian / Niên khóa"/>
                                        <field name="institution" string="Cơ sở đào tạo / Đơn vị / Cấp quản lý"/>
                                        <field name="name" string="Nội dung / Chuyên ngành / Tên đề tài / Tên giải thưởng"/>
                                        <field name="role" string="Vai trò / Cương vị"/>
                                        <field name="result" string="Kết quả / Xếp loại"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Mục 7: Công trình công bố (Có cờ is_top_selected tối đa 5 bài) -->
                            <group string="7. Các Công trình Khoa học Đã Công bố (Tích chọn tối đa 5 bài tiêu biểu)">
                                <field name="publication_ids" nolabel="1">
                                    <list editable="bottom" decoration-info="is_top_selected">
                                        <field name="sequence" widget="handle"/>
                                        <field name="is_top_selected" widget="boolean_toggle" string="Tiêu biểu (Tối đa 5)"/>
                                        <field name="name" string="Tên bài báo / Công trình"/>
                                        <field name="authors" string="Tác giả"/>
                                        <field name="journal" string="Tạp chí / Hội thảo"/>
                                        <field name="year" string="Năm"/>
                                        <field name="pub_type" string="Phân loại"/>
                                        <field name="impact_factor_rank" string="IF / Điểm HĐ"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Các mục văn bản khác -->
                            <group string="6, 8, 11, 12, 14. Kinh nghiệm Quản lý, Sách, Ứng dụng &amp; Thành tựu khác">
                                <group>
                                    <field name="management_experience" placeholder="6. Kinh nghiệm quản lý, giảng dạy &amp; đào tạo..."/>
                                    <field name="published_books" placeholder="8. Sách, giáo trình, tài liệu tham khảo đã xuất bản..."/>
                                    <field name="practical_applications" placeholder="11. Công trình, giải pháp áp dụng vào thực tiễn..."/>
                                </group>
                                <group>
                                    <field name="postgraduate_supervision" placeholder="12. Hướng dẫn nghiên cứu sinh, học viên cao học..."/>
                                    <field name="other_achievements" placeholder="14. Thành tựu hoạt động KH&amp;CN nổi bật khác..."/>
                                    <field name="commitment_statement" placeholder="15. Lời cam đoan của cá nhân..."/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: THIẾT LẬP, MIỄN GIẢM & CHỮ KÝ SỐ -->
                        <page string="Thiết lập &amp; Miễn giảm" name="settings_reductions">
                            <group>
                                <group string="Định mức chức danh &amp; Miễn giảm">
                                    <field name="title_norm_id"/>
                                    <field name="study_weeks"/>
                                    <field name="reduction_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Tài khoản &amp; Chữ ký số">
                                    <field name="user_id"/>
                                    <field name="signature_image" widget="image" class="oe_avatar" string="Ảnh chữ ký số"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_faculty_lecturer" model="ir.actions.act_window">
        <field name="name">Hồ sơ Giảng viên</field>
        <field name="res_model">faculty.lecturer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_position': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hồ sơ giảng viên mới để quản lý công tác đào tạo, NCKH và lý lịch khoa học.
            </p>
        </field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_faculty_lecturer_item"
              name="Hồ sơ Giảng viên"
              parent="faculty_work_mgmt.menu_faculty_lecturer_root"
              action="action_faculty_lecturer"
              sequence="10"/>
</odoo>
