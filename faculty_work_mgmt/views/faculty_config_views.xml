    <!-- 8. DANH MỤC HỆ SỐ QUY ĐỔI GIỜ CHUẨN                                -->
    <!-- =================================================================== -->
    <record id="view_faculty_conversion_factor_search" model="ir.ui.view">
        <field name="name">faculty.conversion.factor.search</field>
        <field name="model">faculty.conversion.factor</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Hệ số Quy đổi">
                <field name="name" string="Tên hoạt động quy đổi"/>
                <field name="code" string="Mã quy chuẩn"/>
                <filter string="1. Giảng dạy" name="filter_teaching" domain="[('category', '=', 'teaching')]"/>
                <filter string="Giờ lên lớp trực tiếp (b)" name="filter_direct" domain="[('teaching_branch', '=', 'direct')]"/>
                <filter string="Giờ quy đổi GD khác" name="filter_converted" domain="[('teaching_branch', '=', 'converted')]"/>
                <separator/>
                <filter string="2. NCKH" name="filter_research" domain="[('category', '=', 'research')]"/>
                <filter string="3. Hoạt động khác" name="filter_other" domain="[('category', '=', 'other')]"/>
                <separator/>
                <filter string="Đang áp dụng" name="filter_active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Nhóm công việc" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Nhánh giảng dạy" name="group_branch" context="{'group_by': 'teaching_branch'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_faculty_conversion_factor_list" model="ir.ui.view">
        <field name="name">faculty.conversion.factor.list</field>
        <field name="model">faculty.conversion.factor</field>
        <field name="arch" type="xml">
            <list string="Danh mục Hệ số Quy đổi Giờ chuẩn" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category" widget="badge"
                       decoration-info="category == 'teaching'"
                       decoration-success="category == 'research'"
                       decoration-warning="category == 'other'"/>
                <field name="teaching_branch"
                       invisible="category != 'teaching'"
                       widget="badge"
                       decoration-primary="teaching_branch == 'direct'"
                       decoration-info="teaching_branch == 'converted'"/>
                <field name="unit"/>
                <field name="coefficient"/>
                <field name="notes" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_faculty_conversion_factor_form" model="ir.ui.view">
        <field name="name">faculty.conversion.factor.form</field>
        <field name="model">faculty.conversion.factor</field>
        <field name="arch" type="xml">
            <form string="Hệ số Quy đổi Giờ chuẩn">
                <header>
                    <button name="action_back_to_list" string="Quay lại danh sách" type="object" class="btn-secondary" icon="fa-arrow-left"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên hoạt động / Công việc quy đổi"/>
                        <h1>
                            <field name="name" placeholder="VD: Lên lớp lý thuyết, Coi thi, Bài báo WoS/Scopus..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Phân loại nhiệm vụ">
                            <field name="code"/>
                            <field name="category"/>
                            <field name="teaching_branch" invisible="category != 'teaching'"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Quy chuẩn &amp; Đơn vị tính">
                            <field name="unit"/>
                            <field name="coefficient"/>
                        </group>
                    </group>
                    <group string="Căn cứ quy chuẩn / Ghi chú">
                        <field name="notes" placeholder="Căn cứ quyết định, thông tư ban hành định mức..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_faculty_conversion_factor" model="ir.actions.act_window">
        <field name="name">Hệ số Quy đổi Giờ chuẩn</field>
        <field name="res_model">faculty.conversion.factor</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1, 'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cấu hình bảng hệ số quy đổi động (Số lượng * Hệ số = Giờ chuẩn) cho 3 nhóm Giảng dạy, NCKH và Hoạt động khác.
            </p>
        </field>
    </record>

    <menuitem id="menu_faculty_conversion_factor"
