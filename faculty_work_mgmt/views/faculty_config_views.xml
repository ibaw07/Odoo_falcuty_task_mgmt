    <!-- 9. CẤU HÌNH THIẾT LẬP KHOA & BÙ TRỪ CHÉO (RES.CONFIG.SETTINGS)       -->
    <!-- =================================================================== -->
    <record id="res_config_settings_view_form_inherit_faculty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.faculty</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Khoa Đào tạo" string="Khoa Đào tạo" name="faculty_work_mgmt">
                    <block title="Hệ số Bù trừ chéo &amp; Đơn giá Giờ vượt" name="faculty_cross_offset_settings">
                        <setting string="Giảng dạy ➔ NCKH (rate_t_to_r)" help="Hệ số quy đổi khi lấy giờ giảng dạy thừa ban đầu (m = a - A) bù sang giờ NCKH thiếu (c &lt; C, với c &gt;= 0.25*C).">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="rate_t_to_r" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="NCKH ➔ Giảng dạy (rate_r_to_t)" help="Hệ số quy đổi khi lấy giờ NCKH thừa ban đầu (o = c - C) bù sang giờ giảng dạy thiếu (a &lt; A).">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="rate_r_to_t" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Đơn giá 1 giờ giảng vượt (VNĐ)" help="Đơn giá thanh toán cho mỗi giờ lên lớp vượt mốc 50% định mức (n = max(0, b - B)) khi giảng viên hoàn thành nhiệm vụ.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="overtime_teaching_rate" class="oe_inline"/>
                                    <span class="ms-1">VNĐ / giờ</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

